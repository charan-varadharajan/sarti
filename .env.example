# Local development values only. Replace them outside local development.
SARTI_ENVIRONMENT=development
SARTI_LOG_LEVEL=INFO
SARTI_POSTGRES_DB=sarti
SARTI_POSTGRES_USER=sarti_local
SARTI_POSTGRES_PASSWORD=replace-for-local-use
SARTI_POSTGRES_PORT=5433
SARTI_DATABASE_URL=postgresql+psycopg://sarti_local:replace-for-local-use@postgres:5432/sarti
SARTI_WEBAUTHN_RP_ID=localhost
SARTI_WEBAUTHN_ORIGIN=http://localhost:8000

# Optional cloud assist stays disabled. No provider key belongs in a mobile build.
SARTI_CLOUD_AI_ENABLED=false
SARTI_CLOUD_AI_REVIEWED=false
SARTI_CLOUD_AI_MODEL=
SARTI_GEMINI_API_KEY=
